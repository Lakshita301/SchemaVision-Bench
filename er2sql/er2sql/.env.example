# Copy this file to .env (in the project root) and fill in real keys.
# .env is loaded automatically by the CLI (via python-dotenv) -- you do not
# need to `export` these manually, as long as the file is named exactly `.env`
# and sits in the project root next to this .env.example file.
#
# You only need to fill in the keys for the providers you actually reference
# in config/config.yaml (via each model's `api_key_env` field). Delete or
# ignore the rest.

# OpenAI (GPT models). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini, via its OpenAI-compatible endpoint.
# https://ai.google.dev/gemini-api/docs/openai
GEMINI_API_KEY=

# Anthropic Claude, if used through an OpenAI-compatible proxy/gateway.
# (The official Anthropic API is not OpenAI-schema-compatible natively;
# use a gateway such as OpenRouter, or your own proxy, and set api_base
# in config.yaml accordingly.)
ANTHROPIC_API_KEY=

# OpenRouter -- a single OpenAI-compatible gateway that can reach most of
# the models in the locked model pool (Gemini, Qwen, GLM, Gemma, etc.)
# under one API key. Useful if you don't want to manage N separate keys.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Qwen (Alibaba DashScope OpenAI-compatible endpoint), if used directly
# instead of via OpenRouter.
QWEN_API_KEY=

# Mistral official API.
MISTRAL_API_KEY=

# Groq OpenAI-compatible API (useful for non-final smoke tests).
GROQ_API_KEY=

# Dedicated least-privilege PostgreSQL role used for paper verification runs.
# Provision using docs/POSTGRES_PAPER_RUN_SETUP.md; never use the postgres
# superuser as the model-run database account.
ER2SQL_VERIFY_DB_PASSWORD=
